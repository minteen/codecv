{
  "name": "codecv",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit && eslint src --ext .vue,.js,.ts",
    "lint": "eslint src --ext .vue,.js,.ts",
    "lint:fix": "eslint src --ext .vue,.js,.ts --fix",
    "format": "prettier --write src build tests pdf-service/*.mjs vite.config.ts index.html",
    "test": "node --test tests/*.test.mjs",
    "pdf:install": "npm --prefix pdf-service ci",
    "pdf:start": "npm --prefix pdf-service start",
    "pdf:test": "npm --prefix pdf-service test"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.1.1",
    "@codemirror/lang-markdown": "^6.0.4",
    "@codemirror/theme-one-dark": "^6.1.0",
    "@vueuse/core": "^9.13.0",
    "aos": "^2.3.4",
    "codemirror": "^6.0.1",
    "driver.js": "^1.2.1",
    "element-plus": "^2.2.19",
    "markdown-transform-html": "^1.7.2",
    "nprogress": "^0.2.0",
    "pinia": "^2.0.27",
    "vue": "^3.2.41",
    "vue-codemirror": "^6.1.1",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@types/aos": "^3.0.4",
    "@types/node": "^18.11.7",
    "@types/nprogress": "^0.2.0",
    "@typescript-eslint/eslint-plugin": "^5.58.0",
    "@typescript-eslint/parser": "^5.58.0",
    "@vitejs/plugin-vue": "^3.2.0",
    "eslint": "^8.38.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.11.0",
    "prettier": "^2.8.7",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass": "^1.55.0",
    "typescript": "^4.6.4",
    "unplugin-auto-import": "^0.11.4",
    "unplugin-vue-components": "^0.22.9",
    "vite": "^3.2.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vue-eslint-parser": "^9.1.1",
    "vue-tsc": "^1.0.9"
  },
  "keywords": [
    "markdown-resume",
    "markdown-pdf",
    "markdown-to-pdf",
    "markdown2pdf",
    "markdown-resume-pdf"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minteen/codecv.git"
  }
}
